{
    "manifest_version": 3,
    "name": "TabSort for YouTube",
    "version": "1.0.0",
    "description": "Sort YouTube watch tabs by remaining time.",
    "icons": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "permissions": [
      "tabs",
      "alarms",
      "scripting",
      "webNavigation",
      "storage"
    ],
    "host_permissions": [
      "*://*.youtube.com/*"
    ],
    "background": {
      "service_worker": "background/service-worker.js",
      "type": "module"
    },
    "action": {
      "default_popup": "popup/popup.html",
      "default_title": "TabSort",
      "default_icon": {
        "16": "assets/icons/icon16.png",
        "32": "assets/icons/icon32.png"
      }
    },
    "content_scripts": [
      {
        "matches": ["*://*.youtube.com/*"],
        "js": ["dist/content-runtime.js"],
        "run_at": "document_end"
      }
    ]
  }
